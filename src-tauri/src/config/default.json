{
  "app": {
    "metaInfo": {
      "updateLog": "Tauri v1.0.0 自带配置",
      "version": 202601010000,
      "id": "internal"
    },
    "mode": "default",
    "autoStart": { "enabled": false },
    "remoteConfig": {
      "enabled": true,
      "url": "https://raw.giteeusercontent.com/wangliang181230/dev-sidecar-config/raw/main/remote_config.json",
      "personalUrl": ""
    },
    "startShowWindow": true,
    "needCheckHideWindow": true,
    "showHideShortcut": "Alt + S",
    "windowSize": { "width": 900, "height": 750 },
    "theme": "dark",
    "closeAction": "ask",
    "autoChecked": true,
    "skipPreRelease": true,
    "dock": { "hideWhenWinClose": false },
    "closeStrategy": 0,
    "showShutdownTip": true,
    "logDisabled": false,
    "logFileSavePath": "${logDir}",
    "keepLogFileCount": 15,
    "maxLogFileSize": 1,
    "maxLogFileSizeUnit": "GB"
  },
  "server": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 31181,
    "fakeServerMaxLength": 100,
    "setting": {
      "NODE_TLS_REJECT_UNAUTHORIZED": true,
      "verifySsl": true,
      "allowTls12": false,
      "allowHttp2": true,
      "interceptMode": "intercepts-only",
      "script": { "enabled": true, "defaultDir": "./extra/scripts/" },
      "userBasePath": "${userBase}",
      "rootDir": "${userBase}",
      "rootCaFile": { "certPath": "${caCert}", "keyPath": "${caKey}" },
      "defaultTimeout": 20000,
      "defaultKeepAliveTimeout": 30000,
      "streamBodyThreshold": 1048576,
      "timeoutMapping": { "github.com": { "timeout": 20000, "keepAliveTimeout": 30000 } },
      "lowSpeedDelay": 200
    },
    "compatible": { "connect": {}, "request": {} },
    "cloudflareRoute": { "enabled": false, "preferredEndpoint": "", "mode": "blacklist", "domains": {} },
    "intercept": { "enabled": true },
    "intercepts": {
      "github.com": {
        ".*": { "sni": "baidu.com" },
        "^([\\w.-]+){2,}/?(\\?.*)?$": {
          "tampermonkeyScript": "https://raw.giteeusercontent.com/wangliang181230/dev-sidecar-config/raw/main/tampermonkey.js",
          "script": "https://raw.giteeusercontent.com/wangliang181230/dev-sidecar-config/raw/main/GithubEnhanced-High-Speed-Download.user.js",
          "remark": "注：上面所使用的脚本地址，为高速镜像地址。",
          "desc": "油猴脚本：高速下载 Git Clone/SSH、Release、Raw、Code(ZIP) 等文件 (公益加速)"
        },
        "/fluidicon.png": { "cacheDays": 365, "desc": "Github那只猫的图片，缓存1年" },
        "^((/[^/]+){2})/pull/\\d+/open_with_menu.*$": { "cacheDays": 7 },
        "^((/[^/]+){2,})/raw((/[^/]+)+\\.(jpg|jpeg|png|gif))(\\?.*)?$": {
          "proxy": "https://raw.githubusercontent.com${m[1]}${m[3]}",
          "sni": "baidu.com",
          "cacheDays": 7
        },
        "^((/[^/]+){2,})/raw((/[^/]+)+\\.js)(\\?.*)?$": {
          "proxy": "https://raw.githubusercontent.com${m[1]}${m[3]}",
          "sni": "baidu.com",
          "responseReplace": { "headers": { "content-type": "application/javascript; charset=utf-8" } }
        }
      },
      "github.githubassets.com": { ".*": { "sni": "baidu.com" } },
      "camo.githubusercontent.com": { "^[a-zA-Z0-9/]+(\\?.*)?$": { "cacheDays": 365 } },
      "collector.github.com": { ".*": { "sni": "baidu.com" } },
      "customer-stories-feed.github.com": { ".*": { "proxy": "customer-stories-feed.fastgit.org" } },
      "user-images.githubusercontent.com": { "^/.*\\.png(\\?.*)?$": { "cacheDays": 365 } },
      "private-user-images.githubusercontent.com": { "^/.*\\.png(\\?.*)?$": { "cacheDays": 30 } },
      "avatars.githubusercontent.com": { "^/u/\\d+(\\?.*)?$": { "cacheDays": 365 } },
      "api.github.com": {
        "^/_private/browser/stats$": { "success": true },
        ".*": { "sni": "baidu.com" }
      },
      "*.docker.com": { ".*": { "sni": "baidu.com" } },
      "login.docker.com": { "/favicon.ico": { "proxy": "hub.docker.com", "sni": "baidu.com" } },
      "www.google.com": { "/recaptcha/.*": { "proxy": "www.recaptcha.net" } },
      "www.gstatic.com": { "/recaptcha/.*": { "proxy": "www.recaptcha.net" } },
      "ajax.googleapis.com": {
        ".*": {
          "proxy": "ajax.proxy.ustclug.org",
          "backup": ["gapis.geekzu.org"],
          "test": "ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"
        }
      },
      "fonts.googleapis.com": {
        ".*": {
          "proxy": "fonts.googleapis.cn",
          "backup": ["fonts.loli.net"],
          "test": "https://fonts.googleapis.com/css?family=Oswald"
        }
      },
      "fonts.gstatic.com": {
        ".*": {
          "proxy": "fonts-gstatic.proxy.ustclug.org",
          "backup": ["gstatic.loli.net"],
          "test": "https://fonts.googleapis.com/css?family=Oswald"
        }
      },
      "themes.googleapis.com": {
        ".*": { "proxy": "themes.loli.net", "backup": ["themes.proxy.ustclug.org"] }
      },
      "themes.googleusercontent.com": { ".*": { "proxy": "google-themes.proxy.ustclug.org" } },
      "clients*.google.com": { ".*": { "abort": false } },
      "www.googleapis.com": { ".*": { "abort": false } },
      "lh*.googleusercontent.com": { ".*": { "abort": false } },
      "*.s3.1amazonaws1.com": { "/sqlite3/.*": { "redirect": "npmmirror.com/mirrors" } },
      "*.carbonads.com": { "/carbon.*": { "abort": true, "desc": "广告拦截" } },
      "*.buysellads.com": { "/ads/.*": { "abort": true, "desc": "广告拦截" } }
    },
